# Required: Vault AppRole login + path to the KV v2 secret holding the bot token.
# The bot token itself is never set here or anywhere on disk — it is read from
# Vault at startup only.
VAULT_ADDR=https://vault.example.domain
VAULT_ROLE_ID=role_id
VAULT_SECRET_ID=secret_id
VAULT_SECRET_PATH=secret_path

# Image tag to run; set by the operator, never hardcoded in docker-compose.yml.
APP_VERSION=v1.2.0

# --- Optional, non-secret. Defaults shown are what the app uses if unset. ---

# AppRole auth mount point.
# VAULT_AUTH_MOUNT=approle

# KV v2 mount point.
# VAULT_KV_MOUNT=secret

# Path, inside the container, to a CA bundle for a private Vault CA. The file
# must be mounted separately (see README). Unset means the system trust store
# is used; TLS verification is always on.
# VAULT_CA_PATH=

# Vault HTTP timeout in seconds.
# VAULT_TIMEOUT=5.0

# SQLite database path, must live on the mounted data volume.
# UPB_DB_PATH=/data/upb.sqlite3

# Python logging level.
# UPB_LOG_LEVEL=INFO

# Minimum seconds between pings from one user in one chat (root is exempt).
# UPB_PING_COOLDOWN_SECONDS=5
